<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.atlas" path="/org/gnome/shell/extensions/atlas/">
    <key name="tema" type="s">
      <choices>
        <choice value="noite"/>
        <choice value="papel"/>
        <choice value="cristal"/>
        <choice value="neon"/>
        <choice value="halloween"/>
        <choice value="natal"/>
      </choices>
      <default>"noite"</default>
      <summary>Tema visual</summary>
      <description>Aparência da doca: noite, papel, cristal, neon, halloween ou natal.</description>
    </key>
    <key name="tamanho-icone" type="i">
      <range min="32" max="96"/>
      <default>52</default>
      <summary>Tamanho dos ícones</summary>
      <description>Tamanho base dos ícones, em pixels.</description>
    </key>
    <key name="lente-forca" type="d">
      <range min="1.0" max="2.5"/>
      <default>1.75</default>
      <summary>Força da lente</summary>
      <description>Ampliação máxima do ícone sob o ponteiro (1.0 desliga a lente).</description>
    </key>
    <key name="lente-largura" type="i">
      <range min="30" max="160"/>
      <default>70</default>
      <summary>Largura da lente</summary>
      <description>Quantos ícones vizinhos a lente alcança, em pixels.</description>
    </key>
    <key name="posicao" type="s">
      <choices>
        <choice value="baixo"/>
        <choice value="esquerda"/>
        <choice value="direita"/>
      </choices>
      <default>"baixo"</default>
      <summary>Posição</summary>
      <description>Borda da tela onde a doca fica.</description>
    </key>
    <key name="margem" type="i">
      <range min="0" max="60"/>
      <default>8</default>
      <summary>Margem da borda</summary>
      <description>Distância entre a doca e a borda da tela, em pixels.</description>
    </key>
    <key name="reservar-espaco" type="b">
      <default>true</default>
      <summary>Reservar espaço para a doca</summary>
      <description>Janelas maximizadas terminam acima da doca em vez de ficarem por baixo dela. Não vale com o auto-ocultar ligado.</description>
    </key>
    <key name="auto-ocultar" type="b">
      <default>false</default>
      <summary>Auto-ocultar</summary>
      <description>Esconde a doca e mostra ao encostar o ponteiro na borda da tela.</description>
    </key>
    <key name="previa-janelas" type="b">
      <default>true</default>
      <summary>Prévia de janelas</summary>
      <description>Mostra miniaturas das janelas de um app ao parar o ponteiro sobre o ícone.</description>
    </key>
    <key name="monitores" type="s">
      <default>"principal"</default>
      <summary>Telas</summary>
      <description>Onde a doca aparece: "principal", "todas" ou "tela-N" (N = posição da tela, da esquerda para a direita).</description>
    </key>
    <key name="ambientes" type="s">
      <default>"[]"</default>
      <summary>Ambientes</summary>
      <description>Lista (JSON) de ambientes: [{id, nome, cor, apps: [ids .desktop], tema, widgets: [ids], colecoes: [{id, nome, apps}]}]. Vazia usa os favoritos do GNOME.</description>
    </key>
    <key name="ambiente-atual" type="s">
      <default>""</default>
      <summary>Ambiente atual</summary>
      <description>Id do ambiente em uso.</description>
    </key>
    <key name="no-overview" type="b">
      <default>true</default>
      <summary>ATLAS na tela de aplicativos</summary>
      <description>Mantém a doca ATLAS visível no Overview e esconde o dock original do GNOME ali.</description>
    </key>
    <key name="mostrar-icone-painel" type="b">
      <default>true</default>
      <summary>Mostrar o ícone do ATLAS no painel superior</summary>
    </key>
    <key name="troca-roda" type="b">
      <default>true</default>
      <summary>Trocar ambiente com a roda do mouse</summary>
    </key>
    <key name="roda-inverter" type="b">
      <default>false</default>
      <summary>Inverter a direção da roda</summary>
    </key>
    <key name="mostrar-seletor" type="b">
      <default>true</default>
      <summary>Mostrar o seletor de ambiente na doca</summary>
    </key>
    <key name="janelas-seguem" type="b">
      <default>false</default>
      <summary>Janelas seguem o ambiente</summary>
      <description>Ao trocar de ambiente, minimiza as janelas dos apps de outros ambientes e restaura as que foram minimizadas por essa troca.</description>
    </key>
    <key name="atalhos-ativos" type="b">
      <default>true</default>
      <summary>Trocar ambiente com atalhos de teclado</summary>
    </key>
    <key name="atalho-proximo" type="as">
      <default>["&lt;Super&gt;&lt;Alt&gt;Right"]</default>
      <summary>Atalho: próximo ambiente</summary>
    </key>
    <key name="atalho-anterior" type="as">
      <default>["&lt;Super&gt;&lt;Alt&gt;Left"]</default>
      <summary>Atalho: ambiente anterior</summary>
    </key>
    <key name="pomodoro-foco" type="i">
      <range min="1" max="180"/>
      <default>25</default>
      <summary>Pomodoro: duração do foco (min)</summary>
    </key>
    <key name="pomodoro-pausa" type="i">
      <range min="1" max="60"/>
      <default>5</default>
      <summary>Pomodoro: pausa curta (min)</summary>
    </key>
    <key name="pomodoro-pausa-longa" type="i">
      <range min="1" max="120"/>
      <default>15</default>
      <summary>Pomodoro: pausa longa (min)</summary>
    </key>
    <key name="timer-minutos" type="i">
      <range min="1" max="600"/>
      <default>10</default>
      <summary>Timer: duração (min)</summary>
    </key>
    <key name="widgets-posicao" type="s">
      <choices>
        <choice value="depois"/>
        <choice value="antes"/>
      </choices>
      <default>"depois"</default>
      <summary>Posição dos widgets</summary>
      <description>"depois": no fim da doca, depois dos apps. "antes": logo depois do seletor de ambiente, antes dos apps.</description>
    </key>
    <key name="contagem-nome" type="s">
      <default>""</default>
      <summary>Contagem regressiva: nome do evento</summary>
    </key>
    <key name="contagem-data" type="s">
      <default>""</default>
      <summary>Contagem regressiva: data (AAAA-MM-DD)</summary>
    </key>
    <key name="nota-texto" type="s">
      <default>""</default>
      <summary>Texto da nota fixa na doca</summary>
    </key>
    <key name="clipboard-fixados" type="as">
      <default>[]</default>
      <summary>Área de transferência: textos fixados</summary>
      <description>Só os fixados ficam salvos; o histórico do que foi copiado fica apenas na memória.</description>
    </key>
    <key name="dica-dnd-vista" type="b">
      <default>false</default>
      <summary>Dica do Não perturbe já mostrada</summary>
    </key>
    <key name="widgets-largos" type="as">
      <default>[]</default>
      <summary>Widgets em versão larga</summary>
      <description>Ids dos widgets que viram uma faixa larga com mais informação. Só vale com a doca na horizontal.</description>
    </key>
    <key name="relogio-24h" type="b">
      <default>true</default>
      <summary>Relógio: formato de 24 horas</summary>
    </key>
    <key name="atalho-ambiente-1" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;1"]</default>
      <summary>Atalho: ir ao ambiente 1</summary>
    </key>
    <key name="atalho-ambiente-2" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;2"]</default>
      <summary>Atalho: ir ao ambiente 2</summary>
    </key>
    <key name="atalho-ambiente-3" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;3"]</default>
      <summary>Atalho: ir ao ambiente 3</summary>
    </key>
    <key name="atalho-ambiente-4" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;4"]</default>
      <summary>Atalho: ir ao ambiente 4</summary>
    </key>
    <key name="atalho-ambiente-5" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;5"]</default>
      <summary>Atalho: ir ao ambiente 5</summary>
    </key>
    <key name="atalho-ambiente-6" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;6"]</default>
      <summary>Atalho: ir ao ambiente 6</summary>
    </key>
    <key name="atalho-ambiente-7" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;7"]</default>
      <summary>Atalho: ir ao ambiente 7</summary>
    </key>
    <key name="atalho-ambiente-8" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;8"]</default>
      <summary>Atalho: ir ao ambiente 8</summary>
    </key>
    <key name="atalho-ambiente-9" type="as">
      <default>["&lt;Control&gt;&lt;Alt&gt;9"]</default>
      <summary>Atalho: ir ao ambiente 9</summary>
    </key>
    <key name="atalho-numero-ativo" type="b">
      <default>true</default>
      <summary>Ir direto ao ambiente N com Ctrl+Alt+número</summary>
    </key>
    <key name="efeito-hover" type="s">
      <choices>
        <choice value="nenhum"/>
        <choice value="brilho"/>
        <choice value="elevar"/>
      </choices>
      <default>"nenhum"</default>
      <summary>Efeito ao passar o mouse</summary>
      <description>Além da lente: "brilho" acende o fundo do ícone, "elevar" sobe o ícone alguns pixels.</description>
    </key>
    <key name="animacao-abertura" type="s">
      <choices>
        <choice value="nenhuma"/>
        <choice value="deslizar"/>
        <choice value="surgir"/>
      </choices>
      <default>"nenhuma"</default>
      <summary>Animação de abertura</summary>
      <description>Como a doca aparece ao ser criada (ao ligar a extensão ou mudar de tela).</description>
    </key>
    <key name="estilo-indicador" type="s">
      <choices>
        <choice value="ponto"/>
        <choice value="barra"/>
        <choice value="nenhum"/>
      </choices>
      <default>"ponto"</default>
      <summary>Indicador de app aberto</summary>
    </key>
  </schema>
</schemalist>
